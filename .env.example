# Database Connection
DATABASE_URL="file:../.data/memorize.sqlite"
# For Vercel deployment (PostgreSQL Migration - Issue #19):
# DATABASE_URL="postgresql://user:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Database Tuning
DB_CHUNK_SIZE=50

# Security & Limits
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=5
MAX_SESSION_RESULTS=2000

# App Policies
NEXT_PUBLIC_PASS_MARK_PERCENT=80

# Learning Algorithm
FAILED_REVIEW_INTERVAL_MINUTES=10
